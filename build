#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

usage() {
    cat <<'USAGE'
Usage: ./build [options]

Options:
      --check-only  Validate source files without writing dist.
  -h, --help        Show this help text.
USAGE
}

check_only=0

while (($#)); do
    case "$1" in
        --check-only)
            check_only=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'error: unknown option %s\n' "$1" >&2
            exit 1
            ;;
    esac
    shift
done

args=()
if [[ "$check_only" -eq 1 ]]; then
    args+=(--check-only)
fi

node "${SCRIPT_DIR}/scripts/build.mjs" "${args[@]}"
